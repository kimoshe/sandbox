LangString Alert_Windows_Arch ${LANG_ENGLISH}               "You are not using a 64bit system.\nSorry, we can not install ${PRODUCT_NAME} on your system."
LangString Alert_Windows_Version ${LANG_ENGLISH}            "${PRODUCT_NAME_CAP} requires Windows 10 or later to install and run."
LangString Another_Instance ${LANG_ENGLISH}                 "Another installer or uninstaller is already running. Close it before proceeding."
LangString Button_Finish ${LANG_ENGLISH}                    "Finish"
LangString Button_Upgrade ${LANG_ENGLISH}                   "Upgrade"
LangString Caption_Install ${LANG_ENGLISH}                  "${PRODUCT_NAME} install"
LangString Caption_Setup ${LANG_ENGLISH}                    "${PRODUCT_NAME} setup"
LangString Caption_Uninstall ${LANG_ENGLISH}                "${PRODUCT_NAME} uninstall"
LangString Caption_Upgrade ${LANG_ENGLISH}                  "${PRODUCT_NAME} upgrade"
LangString Finish_Instructions ${LANG_ENGLISH}              "Select options to run and press Finish$\nor Cancel to simply exit."
LangString Finish_OpenDocumentation ${LANG_ENGLISH}         "Open the Documentation page"
LangString Finish_OpenDonate ${LANG_ENGLISH}                "Open the Donate page"
LangString Finish_RunApp ${LANG_ENGLISH}                    "Start ${PRODUCT_NAME}"
LangString Finish_Text_Install ${LANG_ENGLISH}              "${PRODUCT_NAME_CAP} installation completed successfully."
LangString Finish_Text_Upgrade ${LANG_ENGLISH}              "${PRODUCT_NAME_CAP} upgrade completed successfully."
LangString Finish_Title ${LANG_ENGLISH}                     "Complete!"
LangString Tag_Line ${LANG_ENGLISH}                         "The world’s most trusted roasting software"
LangString UnFinish_Text ${LANG_ENGLISH}                    "${PRODUCT_NAME_CAP} was removed from your computer."
LangString UnFinish_Title ${LANG_ENGLISH}                   "Completed ${PRODUCT_NAME} uninstall"
LangString Welcome_Install_Text ${LANG_ENGLISH}             "Thank you for choosing the world’s most popular roasting software. This setup wizard will guide you through the installation process.$\n$\nClick Next to continue."
LangString Welcome_Install_Title ${LANG_ENGLISH}            "Welcome!"
LangString Welcome_Uninstall_Text ${LANG_ENGLISH}           "Thank you for choosing the world’s most popular roasting software. This uninstall wizard will remove ${PRODUCT_NAME} from your computer.$\n$\nClick Uninstall to continue."
LangString Welcome_Uninstall_Title ${LANG_ENGLISH}          "Uninstaller"
LangString Welcome_Upgrade_Text ${LANG_ENGLISH}             "Thank you for choosing the world’s most popular roasting software. This upgrade wizard will guide you through the installation process.$\n$\nThis process will first remove your existing installation and then install ${PRODUCT_NAME} v${PRODUCT_VERSION}.$\n$\nClick Upgrade to continue."
LangString Welcome_Upgrade_Title ${LANG_ENGLISH}            "Welcome!$\nUpgrade ${PRODUCT_NAME}"

;GERMAN 1031
