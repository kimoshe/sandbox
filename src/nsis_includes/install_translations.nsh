LangString Welcome_Upgrade_Title ${LANG_SPANISH}            "¡Bienvenido!$\nActualizar Artisan"

;ITALIAN 1040
LangString Alert_AbortConfirm ${LANG_ITALIAN}               "Sei sicuro di voler annullare?"
